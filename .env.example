# Meta Marketing API Credentials
# Get these from https://developers.facebook.com

# App ID from App Settings > Basic
META_APP_ID=your_app_id_here

# App Secret from App Settings > Basic
META_APP_SECRET=your_app_secret_here

# Access Token from Marketing API > Tools
# Note: Short-lived tokens expire after 1-2 hours
# Generate a long-lived token for production use
META_ACCESS_TOKEN=your_access_token_here

# Ad Account ID (format: act_XXXXXXXXX or just the number)
# Find it in Business Manager > Business Settings > Ad Accounts
META_AD_ACCOUNT_ID=act_your_account_id_here
